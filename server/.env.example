# OpenRouter API Configuration
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# AI Models to use (comma-separated)
# Options: google/gemini-2.5-flash-lite, google/gemini-2.5-flash, z-ai/glm-4.7, x-ai/grok-4.1-fast
OR_MODELS=inception/mercury-3

# Optional: Ollama for local AI models (requires Ollama to be installed and running)
# Install from: https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434/api/chat
# OLLAMA_MODELS=gemma3:12b

# Optional: direct OpenAI API (e.g. GPT-6 Luna). Models only appear in the app
# when the key is set. Kept separate from OPENAI_API_KEY used by other tools.
# OPENAI_PLATFORM_API_KEY=sk-your-openai-key
# OPENAI_MODELS=gpt-6-luna,gpt-6.1-terra
# OPENAI_REASONING_EFFORT=low   # default; "medium"/"high" = slower, higher chance of running out of tokens

# Optional local ChatGPT subscription route. Requires the installed Codex CLI
# signed in using ChatGPT (codex login status). No credentials are copied.
# Enabling this forces the server to bind 127.0.0.1. Do not proxy it publicly.
# CODEX_ENABLED=true
# CODEX_MODELS=gpt-6.1-terra,gpt-6-luna
# AI_DEFAULT_MODEL=codex:gpt-6.1-terra
# CODEX_BIN=codex

# Server Configuration
PORT=7476

# Optional: CORS settings (defaults to * for all origins)
# AI_CORS_ORIGIN=http://localhost:8345

# Independent factual reviewer. Must be enabled above and differ from the generator.
# If unset, the server selects the first enabled non-Ollama model different from it.
# A pinned reviewer that equals the generator causes a visible failure (no self-review).
# AI_VERIFIER_MODEL=openai:gpt-6.1-terra

# Optional raw verification audit (JSONL). Includes pasted sources and model output;
# leave unset in normal use. Parent directory must exist. Never commit the audit log.
# AI_VERIFICATION_LOG=/absolute/path/to/private/verification.jsonl
